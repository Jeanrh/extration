# Pipeline principal: Tenable Data Stream -> PostgreSQL
# Copie para .env somente em desenvolvimento local. Em EKS, injete configuração
# e segredos pelo overlay real e pela solução corporativa de secrets/identidade.

# Conexões obrigatórias. Mantenha valores sensíveis fora do Git.
TENABLE_BUCKET=
TENABLE_PREFIX=
PG_DSN=

# Deixe vazio para usar pipeline_control.mode. SEED/INCREMENTAL aqui serve
# apenas para sobrescrita deliberada em teste.
INGESTION_MODE=

# Integridade, schema e retenção
MAX_ATTEMPTS=3
EXPECTED_SCHEMA_VERSION={"FINDING":1,"WAS_FINDING":1,"FINDING_ENRICHED_ATTRIBUTES":1}
RETENTION_MONTHS=24
INGEST_FILE_RETENTION_DAYS=90

# Observabilidade. Em desenvolvimento, false evita publicar na AWS.
CLOUDWATCH_NAMESPACE=TenableIngestion
CLOUDWATCH_ENABLED=false
MANIFEST_STALE_HOURS=6
LOG_LEVEL=INFO

# AWS. Em EKS, prefira IRSA ou EKS Pod Identity; campos vazios usam a cadeia
# padrão do boto3. Nunca versione credenciais temporárias ou permanentes.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Download S3 do pipeline
S3_RETRY_MAX_ATTEMPTS=8
S3_RETRY_BASE_DELAY_SECONDS=0.25
S3_RETRY_MAX_DELAY_SECONDS=6

# ---------------------------------------------------------------------------
# Exportador CSV legado
# ---------------------------------------------------------------------------
# Este bloco é usado por exportar.py e pelos scripts de amostra, não pelo
# pipeline PostgreSQL. Reutiliza AWS_REGION, a cadeia de credenciais e os
# parâmetros S3_RETRY_* acima.

AWS_S3_BUCKET=
AWS_S3_VM_FINDINGS_PREFIX=finding/
AWS_S3_WAS_FINDINGS_PREFIX=was_finding/
AWS_S3_FINDING_ENRICHED_PREFIX=finding_enriched_attributes/
AWS_S3_VM_ASSET_PREFIX=asset/
AWS_S3_WAS_ASSET_PREFIX=was_asset/
AWS_S3_WAS_FINDING_ENRICHED_PREFIX=

# Scripts legados de amostra
AWS_S3_KEY=
OUTPUT_FILE=exemplo_consulta.json
S3_SAMPLES_OUTPUT_DIR=samples_s3

# Concorrência/progresso do exportador legado
S3_MAX_WORKERS=24
S3_PROGRESS_EVERY=100

# Overrides globais opcionais do exportador
DEDUPE_BY_FINDING_ID=
MERGE_ENRICHED=

# Overrides por relatório (opcionais): <NOME> = VM_FINDINGS | WAS_FINDINGS |
# INTRANET | INTERNET | GESTAO_VULN.
# <NOME>_LAST_FOUND_DAYS=
# <NOME>_DEDUPE=
# <NOME>_MERGE_ENRICHED=
# <NOME>_MAX_ROWS=
# <NOME>_OUTPUT=
