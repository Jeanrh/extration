# Copie para .env e ajuste. Só AWS_S3_BUCKET é obrigatório; o resto tem default.

# AWS (se vazio, usa a cadeia padrão do boto3: aws configure, env, IAM role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Prefixos dos streams no S3
AWS_S3_VM_FINDINGS_PREFIX=finding/
AWS_S3_WAS_FINDINGS_PREFIX=was_finding/
# recast/aceite; cobre VM e WAS (correlação por finding_id)
AWS_S3_FINDING_ENRICHED_PREFIX=finding_enriched_attributes/
# usados só por gerar_exemplos_s3_datastram.py
AWS_S3_VM_ASSET_PREFIX=asset/
AWS_S3_WAS_ASSET_PREFIX=was_asset/
AWS_S3_WAS_FINDING_ENRICHED_PREFIX=

# Scripts de exemplo (gerar_exemplo_s3.py / gerar_exemplos_s3_datastram.py)
AWS_S3_KEY=
OUTPUT_FILE=exemplo_consulta.json
S3_SAMPLES_OUTPUT_DIR=samples_s3

# S3: concorrência e retry (todos os relatórios)
S3_MAX_WORKERS=24
S3_RETRY_MAX_ATTEMPTS=8
S3_RETRY_BASE_DELAY_SECONDS=0.25
S3_RETRY_MAX_DELAY_SECONDS=6
S3_PROGRESS_EVERY=100

# Defaults globais (cada relatório já traz o seu; isto sobrepõe todos)
DEDUPE_BY_FINDING_ID=
MERGE_ENRICHED=

# ---------------------------------------------------------------------------
# Override por relatório (opcional). <NOME> = VM_FINDINGS | WAS_FINDINGS |
# INTRANET | INTERNET | GESTAO_VULN. Ex.: INTRANET_LAST_FOUND_DAYS=30
#   <NOME>_LAST_FOUND_DAYS   dias de janela Last Found (0 = sem filtro)
#   <NOME>_DEDUPE            true/false — 1 linha por finding_id (mais recente)
#   <NOME>_MERGE_ENRICHED    true/false — junta o stream de recast/aceite
#   <NOME>_MAX_ROWS          limite de linhas no CSV (0 = sem limite)
#   <NOME>_OUTPUT            caminho do CSV de saída
# ---------------------------------------------------------------------------
