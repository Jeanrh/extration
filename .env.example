# Pipeline principal: Tenable Data Stream -> PostgreSQL
# Copie para .env somente em desenvolvimento local. Em EKS, injete configuração
# e segredos pelo overlay real e pela solução corporativa de secrets/identidade.

# Conexões obrigatórias. Mantenha valores sensíveis fora do Git.
TENABLE_BUCKET=
TENABLE_PREFIX=
PG_DSN=

# Deixe vazio para usar pipeline_control.mode. SEED/INCREMENTAL aqui serve
# apenas para sobrescrita deliberada em teste.
INGESTION_MODE=

# Integridade, schema e retenção
MAX_ATTEMPTS=3
EXPECTED_SCHEMA_VERSION={"FINDING":1,"WAS_FINDING":1,"FINDING_ENRICHED_ATTRIBUTES":1}
RETENTION_MONTHS=24
INGEST_FILE_RETENTION_DAYS=90

# Observabilidade. Em desenvolvimento, false evita publicar na AWS.
CLOUDWATCH_NAMESPACE=TenableIngestion
CLOUDWATCH_ENABLED=false
MANIFEST_STALE_HOURS=6
LOG_LEVEL=INFO

# AWS. Em EKS, prefira IRSA ou EKS Pod Identity; campos vazios usam a cadeia
# padrão do boto3. Nunca versione credenciais temporárias ou permanentes.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Download S3 do pipeline
S3_RETRY_MAX_ATTEMPTS=8
S3_RETRY_BASE_DELAY_SECONDS=0.25
S3_RETRY_MAX_DELAY_SECONDS=6

# ---------------------------------------------------------------------------
# Motor de risco  (risk/ — CronJob separado da ingestão)
# ---------------------------------------------------------------------------
# O motor recalcula a prioridade de TODOS os findings, sem filtro de tempo, e
# grava em finding_risk. Reutiliza PG_DSN acima: é o mesmo banco, e duplicar a
# variável só criaria a chance de os dois jobs apontarem para lugares
# diferentes.
#
# As três fontes abaixo são as que o Data Stream NÃO cobre. Nenhuma delas
# derruba o motor quando indisponível: o snapshot anterior no banco continua
# valendo e o cálculo segue com contexto de um ciclo atrás — nunca com contexto
# vazio, que produziria score plausível e silenciosamente errado.

# Versão gravada em cada linha de finding_risk. Suba a cada mudança de regra
# que altere o resultado do cálculo — é o que permite auditar com que versão um
# score foi produzido e reverter a imagem sem tocar na ingestão.
RISK_ENGINE_VERSION=1.0.0

# Tamanho do lote de leitura no recálculo. Só mexa se a memória do pod apertar.
RISK_LOTE=20000

# CSV de arquitetura (Alias/Sigla;Arquitetura). Vazio usa o versionado no repo,
# em risk/referencia/arquitetura.csv, que é editado à mão num PR.
RISK_ARQUITETURA_CSV=

# CMDB — Atlassian Assets (JSM). Alimenta sigla, PCI, BIA, criticidade e
# unidade de negócio, ou seja, todo o vetor py. Sem estas variáveis o
# sync-context pula o CMDB e mantém o snapshot anterior.
JIRA_EMAIL=
JIRA_TOKEN=
JIRA_CLOUD_ID=
# Opcional: descoberto automaticamente pelo cloud_id quando vazio.
JIRA_WORKSPACE_ID=
CMDB_CACHE_HOURS=24

# Jira Service Desk: fila de onde sai o vinculo finding -> ticket.
# Nao sao segredos, sao identificadores da fila; sem os dois o motor
# pula a sincronizacao do Jira e mantem o snapshot anterior.
JIRA_SD_SERVICE_DESK_ID=
JIRA_SD_QUEUE_ID=

# Threat intel — API clássica do Tenable (cloud.tenable.com), NÃO o Data Stream.
# O filtro `cve_category` só existe na API clássica e alimenta nota_threat.
# Continua obrigatório mesmo com toda a base de findings vindo do stream.
ACCESS_KEY=
SECRET_KEY=
VERIFY_TLS=true

# Vault (KV v2, AppRole) — keywords que resolvem a camada tecnológica a partir
# do nome do plugin. Sem Vault, a camada cai no fallback por plugin.family, que
# sozinho já resolve boa parte.
VAULT_ADDR=
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_MOUNT=config
VAULT_LAYER_SECRET_PATH=tenable-vulnerabilities-templates

# ---------------------------------------------------------------------------
# Exportador CSV legado
# ---------------------------------------------------------------------------
# Este bloco é usado por legacy/ (exportador CSV e scripts de amostra), não
# pelo pipeline PostgreSQL. Reutiliza AWS_REGION, a cadeia de credenciais e
# os parâmetros S3_RETRY_* acima. Veja legacy/README.md.

AWS_S3_BUCKET=
AWS_S3_VM_FINDINGS_PREFIX=finding/
AWS_S3_WAS_FINDINGS_PREFIX=was_finding/
AWS_S3_FINDING_ENRICHED_PREFIX=finding_enriched_attributes/
AWS_S3_VM_ASSET_PREFIX=asset/
AWS_S3_WAS_ASSET_PREFIX=was_asset/
AWS_S3_WAS_FINDING_ENRICHED_PREFIX=

# Scripts legados de amostra
AWS_S3_KEY=
OUTPUT_FILE=exemplo_consulta.json
S3_SAMPLES_OUTPUT_DIR=samples

# Concorrência/progresso do exportador legado
S3_MAX_WORKERS=24
S3_PROGRESS_EVERY=100

# Overrides globais opcionais do exportador
DEDUPE_BY_FINDING_ID=
MERGE_ENRICHED=

# Overrides por relatório (opcionais): <NOME> = VM_FINDINGS | WAS_FINDINGS |
# INTRANET | INTERNET | GESTAO_VULN.
# <NOME>_LAST_FOUND_DAYS=
# <NOME>_DEDUPE=
# <NOME>_MERGE_ENRICHED=
# <NOME>_MAX_ROWS=
# <NOME>_OUTPUT=
